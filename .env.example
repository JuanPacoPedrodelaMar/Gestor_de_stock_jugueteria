# Copiar este archivo a ".env" y ajustar valores si hace falta.
# ".env" está en .gitignore: nunca se sube al repositorio.
#
# No hay secretos reales en este proyecto (no usa credenciales de base de
# datos externa ni claves de API), pero se deja este mecanismo listo para
# cuando se incorporen (ej. clave de un servicio externo, credenciales de
# Postgres, etc.): NUNCA se hardcodean en el código ni en el compose.

# --- Puertos publicados en el host ---
PRODUCTOS_PORT=8000
FRONTEND_PORT=8080

# --- URL de la API que usa el NAVEGADOR (frontend) ---
# Debe ser una URL alcanzable desde la máquina del usuario, no el nombre
# interno del servicio Docker.
PRODUCTOS_API_URL=http://localhost:8000

# --- Base de datos del servicio productos ---
# Por defecto usa SQLite en el volumen Docker "productos_data".
# Ejemplo si en el futuro se migra a Postgres:
# PRODUCTOS_DATABASE_URL=postgresql://usuario:password@host:5432/jugueteria
PRODUCTOS_DATABASE_URL=sqlite:////app/data/jugueteria.db

# --- Redis ---
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin123

# --- Movimientos ---
MOVIMIENTOS_PORT=8002
MOVIMIENTOS_API_URL=http://localhost:8002
MOVIMIENTOS_DATABASE_URL=sqlite:////app/data/movimientos.db

# --- Clientes ---
CLIENTES_PORT=8004
CLIENTES_API_URL=http://localhost:8004
CLIENTES_DATABASE_URL=sqlite:////app/data/clientes.db

# --- Usuarios de prueba (SOLO desarrollo; HABILITAR_USUARIOS_PRUEBA=false en un entorno real) ---
# Una cuenta por rol. Los empleados inician sesión con su DNI (el admin también con su email).
# En desarrollo se activan solos (docker-compose.override.yml); en producción NO (docker-compose.prod.yml).
# Los valores por defecto ya están en docker-compose.yml: solo hace falta definirlos acá para cambiarlos.
# HABILITAR_USUARIOS_PRUEBA=true
# PRUEBA_ADMIN_EMAIL=admin@test.com       PRUEBA_ADMIN_DNI=20000001    PRUEBA_ADMIN_PASSWORD=admin12345
# PRUEBA_ALMACEN_EMAIL=almacen@test.com   PRUEBA_ALMACEN_DNI=30000002  PRUEBA_ALMACEN_PASSWORD=almacen123
# PRUEBA_VENTAS_EMAIL=ventas@test.com     PRUEBA_VENTAS_DNI=30000003   PRUEBA_VENTAS_PASSWORD=ventas123
# PRUEBA_MIXTO_EMAIL=mixto@test.com       PRUEBA_MIXTO_DNI=30000004    PRUEBA_MIXTO_PASSWORD=mixto123

# --- Ventana de arrepentimiento para eliminar productos ---
# Segundos durante los que un empleado de almacén/mixto puede eliminar un producto que cargó él mismo.
# Pasado ese tiempo solo un admin. Por defecto 300 (5 minutos).
# PRODUCTO_COOLDOWN_BORRADO_SEGUNDOS=300

# --- Seguridad / red ---
# Orígenes permitidos por CORS (separados por coma). "*" solo para desarrollo.
# CORS_ORIGINS=*

# --- Observabilidad (opcional): docker compose --profile observabilidad up -d ---
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# LOG_LEVEL=INFO

# --- Resiliencia (movimientos -> productos / clientes) ---
# CB_UMBRAL_FALLOS=5            # fallos seguidos que abren el circuit breaker
# CB_ESPERA_SEGUNDOS=15         # segundos abierto antes de probar de nuevo
# PRODUCTOS_REINTENTOS=1        # reintentos de lecturas / de conexión
# DB_POOL_SIZE=20               # pool de conexiones SQLite (por servicio)
# DB_MAX_OVERFLOW=60
