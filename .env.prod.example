# Plantilla de variables de PRODUCCIÓN. Copiar a ".env.prod" en el servidor y completar.
# ".env.prod" NUNCA se sube al repositorio (está en .gitignore).

# Dominio público que apunta al servidor (ej. DuckDNS gratis: mi-jugueteria.duckdns.org).
DOMINIO=

# Imágenes publicadas por el pipeline: <IMAGE_PREFIX>-<servicio>:<IMAGE_TAG>
# ej. IMAGE_PREFIX=ghcr.io/mi-usuario/jugueteria  ->  ghcr.io/mi-usuario/jugueteria-auth:v1.0.0-ae4
IMAGE_PREFIX=
IMAGE_TAG=latest

# Secreto con el que se firman los JWT. Generar uno largo y aleatorio, por ejemplo:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
AUTH_SECRET_KEY=

# Primer usuario administrador (se crea solo si la base de usuarios está vacía).
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD=
AUTH_ADMIN_DNI=

RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# Solo si se levanta el perfil "observabilidad".
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
